
# DeepSeek Cloud API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Sber GigaChat API Configuration
GIGACHAT_CREDENTIALS=your_gigachat_base64_credentials_here
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL_CERTS=false
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# RabbitMQ Connection
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ChromaDB Config
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Mock Prod PostgreSQL Database URL
MOCK_DATABASE_URL=postgresql://postgres:postgres@mock-postgres:5432/postgres

# Langfuse Observability & Tracing Configuration
LANGFUSE_PUBLIC_KEY=pk-lf-demo
LANGFUSE_SECRET_KEY=sk-lf-demo
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_BASE_URL=http://langfuse-web:3000
